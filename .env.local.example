# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (.env.local ห้ามขึ้น GitHub)
# หาค่าได้ที่ Supabase Dashboard -> Project Settings -> API (หรือ API Keys)

# Project URL เช่น https://abcdxyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# กุญแจสาธารณะ (ชื่อ anon หรือ publishable) ใส่ในเบราว์เซอร์ได้
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# กุญแจลับ (ชื่อ service_role หรือ secret) ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามแชร์ ห้ามขึ้น GitHub
# ใช้ในขั้นตอนจัดการผู้ใช้ (F06) ยังไม่จำเป็นสำหรับ F01
SUPABASE_SERVICE_ROLE_KEY=

# ที่อยู่เว็บ ใช้สร้างลิงก์ในอีเมลรีเซ็ตรหัสผ่าน
# ตอนพัฒนา: http://localhost:3000   ตอน deploy: https://ชื่อโปรเจกต์.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ฐานของ URL ไฟล์วิดีโอ/ซับ/ปก (ใช้ใน F03) ถ้าย้ายที่เก็บไฟล์ภายหลัง แก้ที่นี่ที่เดียว
NEXT_PUBLIC_VIDEO_BASE_URL=
